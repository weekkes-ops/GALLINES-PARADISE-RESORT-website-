rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'nabieumelissajosephine@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStaffOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'nabieumelissajosephine@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff'])
      );
    }

    // User profiles
    match /users/{userId} {
      // Authenticated users can read profiles
      allow read: if isAuthenticated();
      // Users can create their own profile on signup/login, or admin can manage
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Users can update their profile or admins can update
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Blog Posts
    match /posts/{postId} {
      // Public can read all published resort stories and news
      allow read: if true;
      // Only staff/admin can create, update, or delete blog articles
      allow create, update, delete: if isStaffOrAdmin();
    }

    // Bookings
    match /bookings/{bookingId} {
      // Public / guests can submit bookings
      allow create: if true;
      // Staff/admin can view all bookings, or guest can read their own
      allow read: if isStaffOrAdmin() || (isAuthenticated() && resource.data.guestEmail == request.auth.token.email);
      // Staff/admin can update/manage booking statuses
      allow update: if isStaffOrAdmin() || (isAuthenticated() && resource.data.guestEmail == request.auth.token.email);
      allow delete: if isAdmin();
    }
  }
}
